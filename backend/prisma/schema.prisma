// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model user{
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  todos     todo[]
  chatMessages ChatMessage[]
  sentAppointments Appointment[] @relation("UserAppointments")
  receivedAppointments Appointment[] @relation("CounselorAppointments")
  sentMessages Message[] @relation("SenderMessages")
  receivedMessages Message[] @relation("ReceiverMessages")
  journals  Journal[]
}

model todo{
  title      String
  id        Int      @id @default(autoincrement())
  completed Boolean  @default(false)
  userId    Int
  user      user     @relation(fields: [userId], references: [id])
}
model ChatMessage {
  id        Int      @id @default(autoincrement())
  message   String
  role      String   // "user" or "assistant"
  createdAt DateTime @default(now())

  userId Int
  user   user @relation(fields: [userId], references: [id])
}

model Appointment {
  id          Int      @id @default(autoincrement())
  userId      Int
  counselorId Int
  date        DateTime
  time        String   // e.g., "09:00 AM"
  status      String   @default("pending") // pending, confirmed, completed, cancelled
  sessionType String   @default("video") // video, phone, in-person
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      user @relation("UserAppointments", fields: [userId], references: [id])
  counselor user @relation("CounselorAppointments", fields: [counselorId], references: [id])
}

model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender   user @relation("SenderMessages", fields: [senderId], references: [id])
  receiver user @relation("ReceiverMessages", fields: [receiverId], references: [id])
}

model Journal {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  mood      String
  tags      String?  // Storing as a comma-separated string for simplicity
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      user     @relation(fields: [userId], references: [id])
}

